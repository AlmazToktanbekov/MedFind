# ── Переменные уровня docker-compose (НЕ путать с backend/.env) ──────────────
# Скопировать в .env рядом с docker-compose.yml: cp .env.example .env

# Postgres
POSTGRES_DB=medfind_db
POSTGRES_USER=medfind_user
POSTGRES_PASSWORD=CHANGE_ME_strong_db_password

# Домен сайта (используется nginx и Let's Encrypt)
DOMAIN=yourdomain.com
# Email для уведомлений Let's Encrypt об истечении сертификата
CERTBOT_EMAIL=you@example.com
