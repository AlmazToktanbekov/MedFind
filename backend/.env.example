# Database
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/medfind
SYNC_DATABASE_URL=postgresql://postgres:password@localhost:5432/medfind

# JWT
SECRET_KEY=your-super-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# OTP
OTP_EXPIRE_MINUTES=5
DEV_MODE=true

# S3
S3_BUCKET_NAME=medfind-media
S3_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key

# SMS (Nikita / InfoBip / etc.)
SMS_API_KEY=your-sms-api-key
SMS_SENDER=MedFind

# App
APP_NAME=MedFind
BACKEND_CORS_ORIGINS=["*"]

# Google Gemini AI
GEMINI_API_KEY=your-gemini-api-key
