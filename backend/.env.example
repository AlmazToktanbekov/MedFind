# ── Database ─────────────────────────────────────────────────────────────────
# На сервере хост — имя docker-compose сервиса (db), локально — localhost
DATABASE_URL=postgresql+asyncpg://medfind_user:CHANGE_ME@db:5432/medfind_db
SYNC_DATABASE_URL=postgresql://medfind_user:CHANGE_ME@db:5432/medfind_db

# ── JWT ───────────────────────────────────────────────────────────────────────
# Сгенерировать: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME_generate_random_hex_32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ── OTP ───────────────────────────────────────────────────────────────────────
OTP_EXPIRE_MINUTES=5
# На сервере обязательно false — иначе OTP виден в ответе
DEV_MODE=false

# ── S3 (необязательно — загрузка по умолчанию локальная в uploads/) ──────────
S3_BUCKET_NAME=medfind-media
S3_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ── SMS (Nikita.kg) ───────────────────────────────────────────────────────────
# Логин личного кабинета smspro.nikita.kg
SMS_LOGIN=
# Пароль API/SMPP — задаётся в кабинете отдельно от пароля кабинета
# (Мой профиль → Изменить пароль → API/SMPP)
SMS_PASSWORD=
# Одобренное имя отправителя. Стандартное общее имя — SMSPRO.KG.
# Своё имя (например MedFind) — после регистрации ОсОО и одобрения операторами.
SMS_SENDER=SMSPRO.KG
# Резерв для других провайдеров — можно оставить пустым
SMS_API_KEY=

# ── AI (Groq) ─────────────────────────────────────────────────────────────────
GROQ_API_KEY=

# ── Firebase Cloud Messaging ──────────────────────────────────────────────────
FIREBASE_PROJECT_ID=medfind-115b6
FIREBASE_SERVICE_ACCOUNT_PATH=serviceAccountKey.json

# ── CORS ──────────────────────────────────────────────────────────────────────
# Укажи домен или IP: ["https://yourdomain.com"]
BACKEND_CORS_ORIGINS=["*"]

# ── App ───────────────────────────────────────────────────────────────────────
APP_NAME=MedFind
